{
  // LLP 0015 attack-surface ledger: forged frames, deputy laundering, prompt
  // fatigue and ceiling mapping, overlay tampering, and deny-ceiling conflict.
  "tempDir": true,
  "tests": {
    "dynamic_permission_attack_rows_fail_closed_and_audit": {
      "args": "run --allow-env --allow-read=. app.js",
      "envs": {
        "ODEN_CAPSEC_POLICY": "policy.json",
        "ODEN_CAPSEC_AUDIT": "redteam-audit.ndjson",
