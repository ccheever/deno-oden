{
  // policy_gen.ts walks the module graph (deno info), collects first-party
  // import-site grants, unions with deno.json's oden.grants, and emits the
  // byte-reproducible .oden/policy.json the engine decide() consumes. --check
  // regenerates and passes when the committed artifact is up to date. "Only
  // your code grants": a dependency self-grant would be ignored (covered by the
  // tool's own run against node_modules; here the graph is clean).
  // Run the generator with tools/ as its first-party root. That keeps the
  // fixture's committed .oden/policy.json as data to check rather than a
  // structural arm for the outer tool process.
  "tests": {
    "generated_policy_is_stable": {
      "args": "run -A ../../../../tools/oden/policy_gen.ts main.js --check",
      "envs": { "ODEN_CAPSEC_ROOT": "../../../../tools" },
      "output": "check.out",
      "exitCode": 0
    }
  }
}
