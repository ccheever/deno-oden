{
  // Deferral-channel conformance enumerator (LLP 0001). A detached, frame-less
  // op scheduled through 7 channels (setTimeout, queueMicrotask, promise
  // reaction, process.nextTick, setImmediate, AsyncResource, dynamic-import
  // continuation) must each be attributed to the scheduling package via the CPED
  // slot. Audit mode records all (exit 0). Seven caller=evil-dep SECRET lines
  // must appear; a channel that drops the principal yields no-user and the
  // matching line is missing.
  "tests": {
    "all_deferral_channels_carry_principal": {
      "args": "run --allow-env app.js",
      "envs": {
        "ODEN_CAPSEC_SPIKE": "1",
        "ODEN_CAPSEC_MODE": "audit",
        "SECRET": "s3cret",
        "STAMP": "x"
      },
      "output": "deferral.out",
      "exitCode": 0
    }
  }
}
