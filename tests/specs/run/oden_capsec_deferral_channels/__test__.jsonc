{
  // Deferral-channel conformance enumerator (LLP 0001). A detached, frame-less
  // op scheduled through 9 channels (setTimeout, queueMicrotask, promise
  // reaction, process.nextTick, setImmediate, AsyncResource, dynamic-import
  // continuation, op-completion continuation, FinalizationRegistry cleanup) must
  // each be attributed to the scheduling package via the CPED slot. Audit mode
  // records all (exit 0). Nine caller=evil-dep SECRET lines must appear; a
  // channel that drops the principal yields no-user and the matching line is
  // missing. --expose-gc makes the FinalizationRegistry cleanup deterministic
  // (the registry is kept alive in evil-dep and the harness drives GC).
  "tests": {
    "all_deferral_channels_carry_principal": {
      "args": "run --allow-env --v8-flags=--expose-gc app.js",
      "envs": {
        "ODEN_CAPSEC_POLICY": "capsec_audit.json",
        "SECRET": "s3cret",
        "STAMP": "x"
      },
      "output": "deferral.out",
      "exitCode": 0
    }
  }
}
