{
  // Eval-to-caller attribution (ENG-23791/ENG-23783). Armed dynamic scripts
  // inherit the callback-time registered caller locator; a one-shot CSPRNG
  // sourceURL only bridges compile to first engine-observed script ID. The
  // fixture covers root, granted/ungranted deps, nested/deferred code,
  // caller-forged sourceURL, same-/cross-context nonce replay, workers, and
  // no-op eval. The baseline case proves the hook is not installed unarmed.
  "tests": {
    "eval_and_function_bind_to_registered_caller": {
      "args": "run --unstable-worker-options --allow-env --allow-read app.js",
      "envs": {
        "ODEN_CAPSEC_POLICY": "capsec_attribution.json",
        "SECRET": "s3cret"
      },
      "output": "attribution.out",
      "exitCode": 0
    },
    "unarmed_eval_behavior_is_unchanged": {
      "args": "run unarmed.js",
      "output": "unarmed.out",
      "exitCode": 0
    }
  }
}
