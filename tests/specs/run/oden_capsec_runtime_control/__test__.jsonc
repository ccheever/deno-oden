{
  // Rev1.1 Stage-B control edges. Deny-only rows stay closed in every mode;
  // inspector authority is exact/static; startup and host-signal activation
  // require the root row rather than ambient fallback.
  "tests": {
    "deny_only_rows_ignore_mode": {
      "args": "run --allow-all deny_matrix.js",
      "if": "unix",
      "variants": {
        "enforce": { "POLICY": "capsec_enforce.json" },
        "audit": { "POLICY": "capsec_audit.json" },
        "permissive": { "POLICY": "capsec_permissive.json" }
      },
      "envs": {
        "ODEN_CAPSEC_POLICY": "${POLICY}",
        "ODEN_CHILD_SAFE_SENTINEL": "safe",
        "ODEN_CAPSEC_CHILD_SENTINEL": "must-not-leak",
        "NODE_OPTIONS": "--trace-warnings",
        "DENO_NODE_USE_OPENSSL_CA": "1"
      },
      "output": "deny_matrix.out",
      "exitCode": 0
    },
    "trusted_runtime_delivers_package_exception": {
      "args": "run --allow-all trusted_exception_child.cjs",
      "if": "unix",
      "envs": { "ODEN_CAPSEC_POLICY": "capsec_enforce.json" },
      "output": "trusted_exception_child.out",
      "exitCode": 0
    },
    "inspector_requires_exact_static_package_row": {
      "args": "run --allow-all inspector_matrix.js",
      "envs": { "ODEN_CAPSEC_POLICY": "capsec_inspector.json" },
      "output": "inspector_matrix.out",
      "exitCode": 0
    },
    "startup_flag_requires_exact_root_row": {
      "args": "run --allow-all startup_driver.js",
      "output": "startup_driver.out",
      "exitCode": 0
    },
    "host_signal_requires_exact_root_row": {
      "args": "run --allow-all signal_driver.js",
      "if": "unix",
      "output": "signal_driver.out",
      "exitCode": 0
    },
    "protected_inspector_endpoint_is_nondelegable": {
      "args": "run --allow-all endpoint_driver.js",
      "output": "endpoint_driver.out",
      "exitCode": 0
    }
  }
}
