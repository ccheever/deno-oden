{
  // Script-creation coverage (LLP 0001): a CommonJS dependency is attributed to
  // its package (not blanket-quarantined), and a forged //# sourceURL in eval'd
  // code cannot impersonate it -- attribution keys on the unforgeable script id.
  // Audit mode records + allows (exit 0).
  "tests": {
    "cjs_attribution_and_sourceurl_redteam": {
      "args": "run --allow-env --allow-read app.js",
      "envs": {
        "ODEN_CAPSEC_POLICY": "capsec_audit.json",
        "HOME": "/home/x",
        "SECRET": "s3cret"
      },
      "output": "cjs.out",
      "exitCode": 0
    }
  }
}
