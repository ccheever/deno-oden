{
  // `/1.1` classifies data: as a non-capability because all bytes are already
  // in the supplied URL. Blob/unknown structural closure and HTTP(S) graph
  // admission are covered by oden_capsec_node_http_socket_closure.
  "tests": {
    "dep_inline_data_import_allowed_under_1_1": {
      "args": "run --allow-all dep_app.js",
      "envs": { "ODEN_CAPSEC_POLICY": "capsec_enforce.json" },
      "output": "baseline.out",
      "exitCode": 0
    },
    "root_remote_import_allowed_under_enforce": {
      "args": "run --allow-all root_app.js",
      "envs": { "ODEN_CAPSEC_POLICY": "capsec_enforce.json" },
      "output": "root_ok.out",
      "exitCode": 0
    },
    "baseline_capsec_off_allows": {
      "args": "run --allow-all dep_app.js",
      "output": "baseline.out",
      "exitCode": 0
    }
  }
}
